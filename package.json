{
  "name": "finance-dashboard-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:analytics-seed": "node scripts/smoke-analytics-seed.mjs",
    "check:query-filters": "node --import tsx scripts/check-query-filters.mjs",
    "check:analytics-calculations": "node --import tsx scripts/check-analytics-calculations.mjs",
    "check:api-contracts": "node scripts/check-api-contracts.mjs",
    "check:armenia-contracts": "node scripts/check-armenia-contracts.mjs",
    "check:plan-fact-contracts": "node scripts/check-plan-fact-contracts.mjs",
    "check:analytics": "npm run check:query-filters && npm run check:analytics-calculations && npm run smoke:analytics-seed && npm run check:api-contracts && npm run check:armenia-contracts && npm run check:plan-fact-contracts",
    "create:user": "node scripts/create-user.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.15",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
