# Copy this file to .env.production on the server.
# Never commit .env.production. It contains production secrets.

# Public base URL used by smoke tests and external links.
APP_BASE_URL="https://dashboard.example.com"

# App port inside the container. Nginx proxies to 127.0.0.1:3000 by default.
PORT="3000"

# Production PostgreSQL connection string.
# With docker-compose.production.yml, host should be "postgres".
DATABASE_URL="postgresql://finance:change-me@postgres:5432/finance_dashboard_hub?schema=public"
POSTGRES_DB="finance_dashboard_hub"
POSTGRES_USER="finance"
POSTGRES_PASSWORD="change-me"

# Production admin seed user.
# Use a real admin email and a strong one-time password.
ADMIN_EMAIL="finance-admin@example.com"
ADMIN_PASSWORD="change-me"

# Generate with:
# openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Production must be "production".
NODE_ENV="production"

# Production must keep auth enabled.
DISABLE_AUTH="false"

NEXT_PUBLIC_APP_NAME="Finance Dashboard Hub"

# Product-core feature flags.
# Recommended first deploy: keep disabled, then enable gradually after smoke/manual checks.
# NEXT_PUBLIC_* values can be build-time sensitive in Next.js Docker builds.
USE_ANALYTICS_ENGINE=false
USE_DASHBOARD_TEMPLATE=false
NEXT_PUBLIC_DASHBOARD_FILTERS_ENABLED=false
NEXT_PUBLIC_FORECAST_ADVANCED_FILTERS_ENABLED=false
NEXT_PUBLIC_ARMENIA_ADVANCED_FILTERS_ENABLED=false

# Dodo API integration placeholders.
# Keep empty unless the production Dodo sync is explicitly enabled and configured.
DODO_API_BASE_URL=
DODO_API_CLIENT_ID=
DODO_API_CLIENT_SECRET=
DODO_API_ACCESS_TOKEN=
DODO_API_REFRESH_TOKEN=
DODO_API_ORGANIZATION_ID=
DODO_API_TIMEOUT_MS=
