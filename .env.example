# Copy this file to .env or .env.local.
# Never commit real .env files.

# Local dev with docker-compose.yml:
# postgresql://finance:finance@localhost:5432/finance_dashboard_hub?schema=public
# Production:
# use the VPS/container PostgreSQL host, database, user, and password.
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_dashboard_hub?schema=public"
POSTGRES_DB="finance_dashboard_hub"
POSTGRES_USER="finance"
POSTGRES_PASSWORD="finance"

# Seeded admin user. Local dev may use the sample values below.
# Production must use a real admin email and a strong one-time password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin"

# Local dev:
# any long random string is acceptable.
# Production:
# generate a unique secret, for example: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Local dev: development
# Production: production
NODE_ENV="development"

# Local smoke/UI checks may set this to true.
# Production must keep this false.
DISABLE_AUTH="false"

NEXT_PUBLIC_APP_NAME="Finance Dashboard Hub"
